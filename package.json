{
  "name": "ai-coder",
  "displayName": "AI Coder",
  "description": "Code using OpenAI, Anthropic, and DeepSeek",
  "version": "0.0.18",
  "publisher": "RizwanAnsari",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rizansari/VSCodeAICoder.git"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "AI"
  ],
  "keywords": [
    "code-generation",
    "openai",
    "anthropic",
    "claude",
    "deepseek",
    "programming-languages",
    "code-completion",
    "ai-powered-coding",
    "productivity-tool",
    "developer-tool",
    "code-snippet-generator",
    "ai-assistant"
  ],
  "activationEvents": [
    "onLanguage:json"
  ],
  "main": "./out/extension.js",
  "files": [
    "out/**/*",
    "media/**/*"
  ],
  "contributes": {
    "configuration": {
      "title": "AI Coder",
      "properties": {
        "ai-coder.customBackend": {
          "type": "string",
          "default": "",
          "description": "Custom Backend URL"
        },
        "ai-coder.provider": {
          "type": "string",
          "default": "anthropic",
          "enum": [
            "anthropic",
            "openai",
            "deepseek"
          ],
          "enumDescriptions": [
            "Use Anthropic API",
            "Use OpenAI API",
            "Use DeepSeek API"
          ],
          "description": "Choose between Anthropic, OpenAI, and DeepSeek as the AI provider"
        },
        "ai-coder.anthropicApiKey": {
          "type": "string",
          "default": "",
          "description": "Anthropic API Key"
        },
        "ai-coder.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API Key"
        },
        "ai-coder.deepseekApiKey": {
          "type": "string",
          "default": "",
          "description": "DeepSeek API Key"
        },
        "ai-coder.customApiKey": {
          "type": "string",
          "default": "",
          "description": "Custom API Key"
        },
        "ai-coder.anthropicModel": {
          "type": "string",
          "default": "claude-3-5-haiku-latest",
          "enum": [
            "claude-3-5-haiku-latest",
            "claude-3-5-sonnet-latest",
            "claude-3-opus-latest",
            "claude-3-7-sonnet-latest"
          ],
          "enumDescriptions": [
            "Claude 3.5 Haiku",
            "Claude 3.5 Sonnet",
            "Claude 3 Opus",
            "Claude 3.7 Sonnet"
          ],
          "description": "Anthropic Model to use"
        },
        "ai-coder.openaiModel": {
          "type": "string",
          "default": "gpt-4o-mini",
          "enum": [
            "gpt-4o-mini",
            "gpt-4o",
            "o1-preview",
            "o1-mini",
            "gpt-4-turbo",
            "chatgpt-4o-latest",
            "o1",
            "o3-mini"
          ],
          "enumDescriptions": [
            "GPT-4o Mini",
            "GPT-4o",
            "O1 Preview",
            "O1 Mini",
            "GPT-4 Turbo",
            "ChatGPT 4o Latest",
            "O1",
            "O3 Mini"
          ],
          "description": "OpenAI Model to use"
        },
        "ai-coder.deepseekModel": {
          "type": "string",
          "default": "deepseek-chat",
          "enum": [
            "deepseek-chat",
            "deepseek-reasoner"
          ],
          "enumDescriptions": [
            "DeepSeek Chat",
            "DeepSeek Reasoner"
          ],
          "description": "DeepSeek Model to use"
        },
        "ai-coder.maxTokens": {
          "type": "number",
          "default": 4096,
          "enum": [
            1024,
            2048,
            4096,
            8192,
            16384,
            32768,
            65536
          ],
          "enumDescriptions": [
            "1024 tokens",
            "2048 tokens",
            "4096 tokens",
            "8192 tokens",
            "16384 tokens",
            "32768 tokens",
            "65536 tokens"
          ],
          "description": "Maximum number of tokens to generate"
        },
        "ai-coder.openDiffView": {
          "type": "boolean",
          "default": false,
          "description": "Open Diff View"
        },
        "ai-coder.diffViewAutoMerge": {
          "type": "boolean",
          "default": false,
          "description": "Diff View Auto Merge"
        },
        "ai-coder.autoSaveGeneratedCode": {
          "type": "boolean",
          "default": true,
          "description": "Auto Save Generated Code"
        },
        "ai-coder.saveGeneratedCodePath": {
          "type": "string",
          "default": "codegen",
          "description": "Path to Save Generated Code relative to workspace"
        },
        "ai-coder.resultView": {
          "type": "string",
          "default": "webview",
          "enum": [
            "webview",
            "markdown",
            "markdown-preview"
          ],
          "enumDescriptions": [
            "Webview",
            "Markdown",
            "Markdown Preview"
          ],
          "description": "Result View"
        }
      }
    },
    "commands": [
      {
        "command": "ai-coder.generateCode",
        "title": "AI Coder: Generate Code with AI API"
      },
      {
        "command": "ai-coder.changeModel",
        "title": "AI Coder: Change AI Provider"
      },
      {
        "command": "ai-coder.selectAnthropicModel",
        "title": "AI Coder: Change Anthropic Model"
      },
      {
        "command": "ai-coder.selectOpenAIModel",
        "title": "AI Coder: Change OpenAI Model"
      },
      {
        "command": "ai-coder.selectDeepSeekModel",
        "title": "AI Coder: Change DeepSeek Model"
      },
      {
        "command": "ai-coder.changeMaxTokens",
        "title": "AI Coder: Change Max Tokens"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-code-generator",
          "title": "AI Coder",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ai-code-generator": [
        {
          "type": "webview",
          "id": "aiCodeGenerator",
          "name": "Main Window"
        }
      ]
    },
    "Keybindings": []
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^14.x.x",
    "@types/vscode": "^1.92.0",
    "@typescript-eslint/eslint-plugin": "^5.30.0",
    "@typescript-eslint/parser": "^5.30.0",
    "eslint": "^8.13.0",
    "typescript": "^4.7.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.3",
    "axios": "^1.7.7",
    "marked": "^14.1.2",
    "openai": "^4.63.0",
    "vscode-diff": "^2.1.1"
  }
}